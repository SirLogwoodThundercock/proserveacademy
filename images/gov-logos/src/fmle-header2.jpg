						<img data-src="//web.archive.org/web/20250327031231/https://labour.gov.ng/wp-content/uploads/revslider/home_1/HM-NPC-COMM.jpg" data-libid="13121" data-lib="medialibrary" title="HM-NPC-COMM.jpg" width="0" height="0" data-dbsrc="Ly9sYWJvdXIuZ292Lm5nL3dwLWNvbnRlbnQvdXBsb2Fkcy9yZXZzbGlkZXIvaG9tZV8xL0hNLU5QQy1DT01NLmpwZw=="/>
