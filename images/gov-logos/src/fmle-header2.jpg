<div class="post-thumbnail-wrap">
	<div class="post-thumbnail">
		<div class="fancy-date"><a title="4:56 pm" href="https://web.archive.org/web/20250327031231/http://labour.gov.ng/2025/02/13/"><span class="entry-month">Feb</span><span class="entry-date updated">13</span><span class="entry-year">2025</span></a></div>
		
